&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '1979-01-01_00:00:00',
 end_date   = '1979-02-01_00:00:00',
 interval_seconds = 10800,          ! = --hours 3
 io_form_geogrid = 2,
/

&geogrid
 ! your domain, as usual
/

&ungrib
 ! not used: era5_to_wps.py replaces ungrib
/

&metgrid
 fg_name = 'era5_int/ERA5',         ! --out era5_int, --prefix ERA5
 io_form_metgrid = 2,
/
